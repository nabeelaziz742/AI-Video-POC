# Django Core & Security
DJANGO_SECRET_KEY=replace-with-a-new-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax
SECURE_HSTS_SECONDS=31536000
DJANGO_LOG_LEVEL=INFO

# AI Video Providers & Timeouts
JSON2VIDEO_API_KEY=your-json2video-key
FAL_KEY=your-fal-key
AI_VIDEO_PROVIDER=json2video
FAL_VIDEO_RESOLUTION=720p
FAL_IMAGE_MODEL=fal-ai/flux/schnell
PROVIDER_JOB_TIMEOUT_SECONDS=1800

# Stripe Billing & Subscriptions
STRIPE_SECRET_KEY=sk_test_replace_with_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_stripe_webhook_secret
STRIPE_PRICE_CREATOR=price_creator_id
STRIPE_PRICE_PRO=price_pro_id
STRIPE_SUCCESS_URL=http://localhost:3000/dashboard?billing=success
STRIPE_CANCEL_URL=http://localhost:3000/dashboard?billing=cancelled
